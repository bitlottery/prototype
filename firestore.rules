rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }
    
    function incoming() { return request.resource.data; }
    
    function isValidTicketEntry(data) {
      return data.keys().hasAll(['payoutAddress', 'depositAddress', 'amountSol', 'tickets', 'timestamp']) &&
             data.keys().size() <= 6 &&
             data.payoutAddress is string &&
             data.payoutAddress.size() >= 32 && data.payoutAddress.size() <= 44 &&
             data.depositAddress is string &&
             data.depositAddress.size() >= 32 && data.depositAddress.size() <= 44 &&
             data.amountSol is number &&
             data.amountSol > 0 &&
             data.tickets is number &&
             data.tickets > 0 &&
             data.timestamp is string &&
             data.timestamp.size() <= 50 &&
             (!('txHash' in data) || (data.txHash is string && data.txHash.size() <= 150));
    }
    
    match /entries/{entryId} {
      allow read: if true;
      allow create: if isValidTicketEntry(incoming());
      allow update, delete: if false;
    }
    
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }
    
    function incoming() { return request.resource.data; }
    
    function isValidTicketEntry(data) {
      return data.keys().hasAll(['payoutAddress', 'depositAddress', 'amount', 'currency', 'usdValue', 'tickets', 'timestamp']) &&
             data.payoutAddress is string &&
             data.payoutAddress.size() < 150 &&
             data.depositAddress is string &&
             data.depositAddress.size() < 150 &&
             data.amount is number &&
             data.amount > 0 &&
             data.currency is string &&
             data.usdValue is number &&
             data.tickets is number &&
             data.tickets > 0 &&
             data.timestamp is string &&
             data.timestamp.size() <= 50 &&
             (!('txHash' in data) || (data.txHash is string && data.txHash.size() <= 150));
    }
    
    match /entries/{entryId} {
      allow read: if true;
      allow create: if isValidTicketEntry(incoming());
      allow update: if false;
      allow delete: if exists(/databases/$(database)/documents/adminSessions/active) &&
                       get(/databases/$(database)/documents/adminSessions/active).data.passcode == 'MzEx';
    }
    
    match /adminSessions/active {
      allow create: if incoming().passcode == 'MzEx';
      allow delete: if resource.data.passcode == 'MzEx';
      allow read: if false;
    }
    
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
